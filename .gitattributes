# Keep Linux line endings (LF) on every text file, even when the repo is
# cloned on Windows. The scripts and configs run inside Linux containers,
# and a Windows line ending (CRLF) breaks them: entrypoint.sh fails to start
# and Apache refuses the rule files.
* text=auto eol=lf

# Images are binary: never touch their bytes.
*.png binary
*.jpg binary
*.gif binary
